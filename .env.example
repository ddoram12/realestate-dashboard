# ============================================================
# 부동산 시장 분석 대시보드 - API 인증키
# ============================================================
# 각 키는 무료 발급. 발급 절차는 README.md 참고.
# 이 파일을 .env 로 복사한 뒤 실제 키를 채워넣으세요.

# KOSIS 통계청 OpenAPI (https://kosis.kr/openapi/)
# - 인구·세대수 시계열
KOSIS_API_KEY=

# 한국부동산원 R-One OpenAPI (https://www.reb.or.kr/r-one/openapi/)
# - 미분양, 매매/전세 가격지수, 입주예정물량
REB_API_KEY=

# 공공데이터포털 OpenAPI (https://www.data.go.kr/)
# - 국토교통부 아파트 매매 실거래가
# - 한국부동산원 청약홈 청약접수 경쟁률
# - 한국부동산원 입주예정물량 (대안 경로)
# 같은 사이트에서 발급한 일반 인증키(Decoding key)를 그대로 사용
DATA_GO_KR_API_KEY=

# 네이버 검색 OpenAPI (https://developers.naver.com/apps/)
# - 도시별 대규모 개발/기업유치 뉴스 보조 수집 (선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# SQLite 캐시 경로 (기본값 사용 권장)
DB_PATH=./data/realestate.db
